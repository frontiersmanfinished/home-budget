rules_version = '2';
// Only the two household Google accounts can read or change the budget.
// The Up sync account (email sign-in, used only by the private GitHub job) can read the budget for the weekly
// backup, and can write only the inbox of Up records and its own status. It can't change the budget itself.
// Replace the two emails and the sync account's UID before publishing (Firestore → Rules).
// Keep the real values out of this public repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function household() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['first.person@gmail.com', 'second.person@gmail.com'];
    }
    function syncAccount() {
      return request.auth != null && request.auth.uid == 'SYNC_ACCOUNT_UID';
    }
    match /households/budget/{document=**} {
      allow read, write: if household();
      allow read: if syncAccount();
    }
    match /households/budget/upInbox/{id} {
      allow write: if syncAccount();
    }
    match /households/budget/sync/state {
      allow write: if syncAccount();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
